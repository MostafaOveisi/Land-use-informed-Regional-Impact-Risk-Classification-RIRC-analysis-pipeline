  build_excel_tables <- function(prefix) {
    
    excel_tables <- list()
    
    excel_tables[[paste0(toupper(prefix), "_Summary")]] <-
      build_summary_sheet(prefix)
    
    sheet_map <- c(
      full_data_model         = "Training_data",
      cv_summary_all          = "Spatial_CV_summary",
      cv_results              = "Spatial_CV_results",
      training_metrics        = "Training_performance",
      variable_importance     = "Variable_importance",
      response_curve_data     = "Response_curves",
      block_checks_df         = "Block_diagnostics",
      sensitivity_results_df  = "Sensitivity_results",
      sensitivity_summary     = "Sensitivity_summary",
      oof_metrics             = "OOF_performance",
      all_performance_metrics = "All_performance",
      overfitting_summary     = "Training_vs_OOF",
      class_area_summary      = "Suitability_area"
    )
    
    for (suffix in names(sheet_map)) {
      
      excel_tables <- add_df_if_valid(
        excel_tables,
        paste0(prefix, "_", suffix),
        paste0(toupper(prefix), "_", sheet_map[[suffix]])
      )
    }
    excel_tables
  }
  
  # ---------- output file ----------
  species_tag <- gsub("[^[:alnum:]_\\-]+", "_", cfg$species_name %||% "species")
  area_tag    <- gsub("[^[:alnum:]_\\-]+", "_", cfg$study_area_name %||% "study_area")
  stamp_tag   <- format(Sys.time(), "%Y%m%d_%H%M%S")
  
  dir.create(tables_dir, showWarnings = FALSE, recursive = TRUE)
  excel_output_file <- file.path(
    tables_dir,
    paste0(species_tag, "_", area_tag, "_", stamp_tag, "_all_results.xlsx")
  )
  
  # ---------- collect sheets ----------
  
  excel_tables <- c(
    build_excel_tables("glo"),
    build_excel_tables("reg")
  )
  
  if (exists("vif_res") &&
      !is.null(vif_res) &&
      length(vif_res$excluded) > 0L) {
    
    excel_tables[["GLO_VIF_excluded"]] <-
      data.frame(
        excluded_predictor = vif_res$excluded,
        stringsAsFactors = FALSE
      )
  }
  
  if (exists("local_vif_excluded") &&
      length(local_vif_excluded) > 0L) {
    
    excel_tables[["REG_VIF_excluded"]] <-
      data.frame(
        excluded_predictor = local_vif_excluded,
        stringsAsFactors = FALSE
      )
  }
  
  # ---------- write workbook ----------
  wb <- openxlsx::createWorkbook()
  header_style <- openxlsx::createStyle(
    textDecoration = "bold", fgFill = "#D9EAF7",
    halign = "center", valign = "center", border = "Bottom"
  )
  
  for (sheet_name in names(excel_tables)) {
    sheet_data <- excel_tables[[sheet_name]]
    
    # use your function if available; fallback if it crashes
    if (exists("prepare_for_excel")) {
      sheet_data <- tryCatch(
        prepare_for_excel(sheet_data),
        error = function(e) {
          message("prepare_for_excel failed for sheet '", sheet_name, "': ", conditionMessage(e),
                  " -> using safe fallback.")
          prepare_for_excel_safe(sheet_data)
        }
      )
    } else {
      sheet_data <- prepare_for_excel_safe(sheet_data)
    }
    
    # final guard
    if (!is.data.frame(sheet_data) || ncol(sheet_data) == 0) {
      sheet_data <- data.frame(note = "empty_or_invalid_sheet", stringsAsFactors = FALSE)
    }
    
    sheet_name_use <- substr(sheet_name, 1, 31)
    openxlsx::addWorksheet(wb, sheet_name_use)
    openxlsx::writeDataTable(wb, sheet = sheet_name_use, x = sheet_data,
                             tableStyle = "TableStyleMedium2", withFilter = TRUE)
    openxlsx::addStyle(wb, sheet = sheet_name_use, style = header_style, rows = 1,
                       cols = seq_len(ncol(sheet_data)), gridExpand = TRUE, stack = TRUE)
    openxlsx::freezePane(wb, sheet = sheet_name_use, firstRow = TRUE)
    openxlsx::setColWidths(wb, sheet = sheet_name_use, cols = seq_len(ncol(sheet_data)), widths = "auto")
  }
  
  openxlsx::saveWorkbook(wb, file = excel_output_file, overwrite = TRUE)
  message("Excel workbook saved successfully: ",
          normalizePath(excel_output_file, winslash = "/", mustWork = FALSE))
}


