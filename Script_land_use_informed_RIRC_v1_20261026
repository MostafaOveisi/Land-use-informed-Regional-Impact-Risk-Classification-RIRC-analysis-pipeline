if (isTRUE(cfg$run_global_sdm)) {
  
  message("Running global SDM module...")
  
  set.seed(cfg$seed_global)
  
  #############################################################################
  # 4.1 Read and clean occurrence data
  #############################################################################
  
  # glo_ prefix stands for "global"
  
  glo_occ_raw <- readr::read_delim(
    cfg$occurrence_file,
    delim = "\t",   # GBIF standard
    locale = readr::locale(encoding = "UTF-8"),
    show_col_types = FALSE,
    guess_max = 100000
  ) %>%
    janitor::clean_names()
  
  n_row_glo_occ <- nrow(glo_occ_raw)
  
  lonlat <- detect_lon_lat(names(glo_occ_raw))
  if (is.na(lonlat$lon) || is.na(lonlat$lat)) {
    stop("Could not detect longitude/latitude columns in the occurrence file.")
  }
  
  glo_occ_dat <- glo_occ_raw %>%
    mutate(
      lon = as.numeric(.data[[names(glo_occ_raw)[lonlat$lon]]]),
      lat = as.numeric(.data[[names(glo_occ_raw)[lonlat$lat]]])
    )
  
  if ("year" %in% names(glo_occ_dat)) {
    glo_occ_dat$year_num <- extract_year(glo_occ_dat$year)
  } else {
    glo_occ_dat$year_num <- NA_integer_
  }
  
  if ("coordinate_uncertainty_in_meters" %in% names(glo_occ_dat)) {
    glo_occ_dat$uncertainty_m <- extract_uncertainty_m(glo_occ_dat$coordinate_uncertainty_in_meters)
  } else if ("coordinate_uncertainty" %in% names(glo_occ_dat)) {
    glo_occ_dat$uncertainty_m <- extract_uncertainty_m(glo_occ_dat$coordinate_uncertainty)
  } else {
    glo_occ_dat$uncertainty_m <- NA_real_
  }
  
  glo_occ_clean <- glo_occ_dat %>%
    filter(
      is.finite(lon), is.finite(lat),
      lon >= -180, lon <= 180,
      lat >= -90, lat <= 90
    ) %>%
    filter(is.na(year_num) | year_num >= cfg$year_min) %>%
    filter(is.na(uncertainty_m) | uncertainty_m <= cfg$max_coord_uncertainty_m) %>%
    distinct(lon, lat, .keep_all = TRUE)
  
  n_clean_glo_occ <- nrow(glo_occ_clean)
  
  if (n_clean_glo_occ < cfg$min_records) {
    stop("Too few cleaned occurrence records remain after filtering.")
  }
  
  glo_occ_sf <- sf::st_as_sf(
    glo_occ_clean,
    coords = c("lon", "lat"),
    crs = cfg$occurrence_crs,
    remove = FALSE
  )
  
  #############################################################################
  # 4.2 Read and prepare predictors
  #############################################################################
  
  glo_pred_files <- list.files(
    cfg$global_pred_dir,
    pattern = "\\.tif(f)?$",
    full.names = TRUE,
    recursive = TRUE
  )
  
  if (length(glo_pred_files) == 0L) stop("No predictor rasters found in global_pred_dir.")
  
  glo_pred_stack <- terra::rast(glo_pred_files)
  
  names(glo_pred_stack) <- standardize_bio_names(names(glo_pred_stack))
  names(glo_pred_stack) <- make.unique(names(glo_pred_stack))
  names(glo_pred_stack) <- c("bio01", "bio02", "bio03", "bio04", "bio05", "bio06", "bio07", "bio08", "bio09", "bio10", "bio11", "bio12", "bio13", "bio14", "bio15", "bio16", "bio17", "bio18", "bio19")
  
  glo_occ_v <- terra::vect(glo_occ_sf)
  glo_occ_values <- terra::extract(glo_pred_stack, glo_occ_v)
  glo_occ_complete <- glo_occ_clean[complete.cases(glo_occ_values[, -1]), ]
  glo_occ_sf <- sf::st_as_sf(glo_occ_complete, coords = c("lon", "lat"), crs = cfg$occurrence_crs, remove = FALSE)
  
  glo_occ_v <- terra::vect(glo_occ_sf)
  
  #############################################################################
  # 4.3 Thinning to one occurrence per predictor raster pixel
  #############################################################################
  
  glo_occ_xy <- terra::crds(glo_occ_v)
  glo_occ_cell_df <- data.frame(
    cell = terra::cellFromXY(glo_pred_stack, glo_occ_xy)
  )
  glo_occ_complete$cell_id <- glo_occ_cell_df$cell
  glo_occ_thin <- glo_occ_complete %>%
    group_by(cell_id) %>%
    slice(1) %>%
    ungroup()
  
  glo_occ_sf_thin <- sf::st_as_sf(
    glo_occ_thin,
    coords = c("lon", "lat"),
    crs = cfg$occurrence_crs,
    remove = FALSE
  )
  
  n_row_glo_final_pres <- nrow(glo_occ_sf_thin)
  
  #############################################################################
  # 4.4 Background sampling
  #############################################################################
  
  glo_pres_proj <- sf::st_transform(glo_occ_sf_thin, cfg$global_crs)
  glo_pres_v_proj <- terra::vect(glo_pres_proj)
  
  glo_pred_proj <- terra::project(glo_pred_stack, cfg$global_crs, method = "bilinear")
  template_global <- terra::rast(glo_pred_proj[[1]])
  glo_aoi <- terra::buffer(glo_pres_v_proj, width = cfg$accessible_buffer_m)
  glo_aoi_r <- terra::rasterize(glo_aoi, template_global, field = 1, background = NA)
  
  # current pixel resolution (x and y)
  r0 <- terra::res(template_global)
  
  # factor to refine/coarsen (assumes square target res)
  fact <- r0[1] / cfg$background_res_m
  
  if (fact > 1) {
    # finer grid
    glo_bg_grid <- terra::disagg(template_global, fact = round(fact), method = "")
  } else if (fact < 1) {
    # coarser grid
    glo_bg_grid <- terra::aggregate(template_global, fact = round(1/fact), fun = "mean")
  } else {
    glo_bg_grid <- template_global
  }
  
  values(glo_bg_grid) <- 1
  glo_bg_grid <- terra::mask(glo_bg_grid, glo_aoi_r)
  
  glo_bias_surface <- make_bias_surface(
    pts = glo_pres_v_proj,
    template_rast = glo_bg_grid,
    smooth_m = cfg$bias_smoothing_m,
    agg_factor = cfg$bias_agg_factor
  )
  
  glo_bg_cells <- which(!is.na(terra::values(glo_bg_grid)))
  glo_pres_cells_bg <- unique(terra::cellFromXY(glo_bg_grid, terra::crds(glo_pres_v_proj)))
  glo_bg_cells <- setdiff(glo_bg_cells, glo_pres_cells_bg)
  
  if (length(glo_bg_cells) < n_row_glo_final_pres) stop("Not enough background cells available.")
  
  glo_bias_vals <- terra::values(glo_bias_surface)[glo_bg_cells]
  glo_bias_vals[is.na(glo_bias_vals)] <- 0
  if (sum(glo_bias_vals) <= 0) {
    glo_bias_vals <- rep(1, length(glo_bg_cells))
  }
  glo_bias_probs <- glo_bias_vals / sum(glo_bias_vals)
  
  glo_sampled_bg_cells <- sample(glo_bg_cells, size = n_row_glo_final_pres, replace = FALSE, prob = glo_bias_probs)
  glo_bg_xy <- terra::xyFromCell(glo_bg_grid, glo_sampled_bg_cells)
  glo_bg_sf_proj <- sf::st_as_sf(
    data.frame(lon = glo_bg_xy[,1], lat = glo_bg_xy[,2]),
    coords = c("lon", "lat"),
    crs = cfg$global_crs,
    remove = FALSE
  )
  glo_bg_sf <- sf::st_transform(glo_bg_sf_proj, cfg$occurrence_crs)
  glo_bg_sf$presence <- 0
  
  glo_pres_sf <- glo_occ_sf_thin
  glo_pres_sf$presence <- 1
  
  #############################################################################
  # 4.5 Build modeling data
  #############################################################################
  
  glo_pres_vals <- terra::extract(glo_pred_stack, terra::vect(glo_pres_sf))
  glo_bg_vals   <- terra::extract(glo_pred_stack, terra::vect(glo_bg_sf))
  
  glo_pres_vals <- glo_pres_vals[, -1, drop = FALSE]
  glo_bg_vals   <- glo_bg_vals[, -1, drop = FALSE]
  
  colnames(glo_pres_vals) <- names(glo_pred_stack)
  colnames(glo_bg_vals) <- names(glo_pred_stack)
  
  glo_pres_df <- cbind(data.frame(presence = 1), glo_pres_vals)
  glo_bg_df   <- cbind(data.frame(presence = 0), glo_bg_vals)
  
  glo_full_data_model <- bind_rows(glo_pres_df, glo_bg_df) %>%
    drop_na()
  
  if (nrow(glo_full_data_model) < 30) stop("Not enough modeling records after extraction.")
  
  glo_predictor_names <- setdiff(names(glo_full_data_model), "presence")
  
  #############################################################################
  # 4.6 Correlation and VIF screening
  #############################################################################
  
  # Candidate predictors
  glo_pred_df <- as.data.frame(glo_full_data_model[, glo_predictor_names, drop = FALSE])
  
  # Keep numeric only
  glo_pred_df <- glo_pred_df[, vapply(glo_pred_df, is.numeric, logical(1)), drop = FALSE]
  
  if (ncol(glo_pred_df) < 2) {
    warning("Fewer than 2 numeric predictors available; skipping correlation/VIF.")
    final_predictors <- colnames(glo_pred_df)
    
  } else {
    # --- Correlation filter ---
    cor_mat <- stats::cor(glo_pred_df, method = "spearman", use = "pairwise.complete.obs")
    cor_drop <- if (ncol(cor_mat) > 1) {
      caret::findCorrelation(abs(cor_mat), cutoff = cfg$cor_threshold, names = TRUE, exact = TRUE)
    } else character(0)
    
    screened_predictors <- setdiff(colnames(glo_pred_df), cor_drop)
    if (length(screened_predictors) < 2) {
      warning("Correlation filter left <2 predictors; reverting to numeric predictors.")
      screened_predictors <- colnames(glo_pred_df)
    }
    
    # --- VIF filter ---
    xdat <- stats::na.omit(glo_pred_df[, screened_predictors, drop = FALSE])
    
    if (ncol(xdat) < 2 || nrow(xdat) < 5) {
      warning("Insufficient complete data for VIF; using correlation-screened predictors.")
      final_predictors <- screened_predictors
      
    } else {
      v <- usdm::vifstep(xdat, th = cfg$vif_threshold)
      
      # safest universal rule for usdm::vifstep object:
      # selected vars = original cols - excluded
      excluded <- tryCatch({
        if (isS4(v) && "excluded" %in% methods::slotNames(v)) methods::slot(v, "excluded")
        else if (is.list(v) && "excluded" %in% names(v)) v$excluded
        else NULL
      }, error = function(e) NULL)
      
      if (!is.null(excluded)) {
        final_predictors <- setdiff(colnames(xdat), as.character(excluded))
      } else {
        # fallback: parse results table if available
        rr <- tryCatch({
          if (isS4(v) && "results" %in% methods::slotNames(v)) methods::slot(v, "results")
          else if (is.list(v) && "results" %in% names(v)) v$results
          else if (is.data.frame(v)) v
          else NULL
        }, error = function(e) NULL)
        
        if (is.data.frame(rr)) {
          nm_col <- intersect(c("Variables", "variables", "Variable", "var"), names(rr))
          final_predictors <- if (length(nm_col) == 1) as.character(rr[[nm_col]]) else screened_predictors
        } else {
          final_predictors <- screened_predictors
        }
      }
      
      final_predictors <- unique(intersect(final_predictors, colnames(xdat)))
      if (length(final_predictors) < 2) {
        warning("VIF extraction failed/too strict; using correlation-screened predictors.")
        final_predictors <- screened_predictors
      }
    }
  }
    
  #############################################################################
  # 4.7 Spatial blocks and model tuning
  #############################################################################
  
  cv_pts <- rbind(
    sf::st_as_sf(data.frame(presence = 1L), geometry = sf::st_geometry(glo_pres_sf)),
    sf::st_as_sf(data.frame(presence = 0L), geometry = sf::st_geometry(glo_bg_sf))
  )
  sf::st_crs(cv_pts) <- sf::st_crs(glo_pres_sf)
  
  # Extract predictors for exact row sync
  cv_ext <- terra::extract(glo_pred_stack, terra::vect(cv_pts))
  cv_ext <- as.data.frame(cv_ext)[, -1, drop = FALSE]
  cv_dat <- cbind(sf::st_drop_geometry(cv_pts), cv_ext)
  cv_dat <- cv_dat[, c("presence", final_predictors), drop = FALSE]
  
  cc_cv <- stats::complete.cases(cv_dat)
  cv_dat <- cv_dat[cc_cv, , drop = FALSE]
  cv_pts <- cv_pts[cc_cv, , drop = FALSE]
  cv_pts$.row_id <- seq_len(nrow(cv_pts))
  cv_pts$presence <- cv_dat$presence
  
  
  # Storage objects
  
  cv_results <- list()
  
  block_checks_df <- data.frame(
    block_size = cfg$block_sizes_m,
    AUC_mean   = NA_real_,
    TSS_mean   = NA_real_
  )
  
  best_block_size <- cfg$block_size_m
  
  # Block-size tuning loop
  
  for (bs in cfg$block_sizes_m) {
    
    message("Evaluating block size: ", bs, " m")
    
    cv_obj <- tryCatch(
      
      blockCV::cv_spatial(
        x = cv_pts,
        column = "presence",
        size = bs,
        k = cfg$n_blocks,
        selection = "random",
        iteration = 100,
        hexagon = FALSE,
        plot = FALSE,
        progress = FALSE
      ),
      
      error = function(e) {
        
        warning(
          "cv_spatial failed for block size ",
          bs,
          ": ",
          conditionMessage(e)
        )
        
        NULL
      }
    )
    
    if (
      is.null(cv_obj) ||
      is.null(cv_obj$folds_list) ||
      length(cv_obj$folds_list) == 0
    ) {
      next
    }
    
    fold_metrics <- list()
    
  
    # Fold loop
    
    for (fold_id in seq_along(cv_obj$folds_list)) {
      
      this_fold <- cv_obj$folds_list[[fold_id]]
      
      if (length(this_fold) < 2)
        next
      
      train_ids <-
        if (is.numeric(this_fold[[1]])) {
          as.integer(this_fold[[1]])
        } else {
          this_fold[[1]]$.row_id
        }
      
      test_ids <-
        if (is.numeric(this_fold[[2]])) {
          as.integer(this_fold[[2]])
        } else {
          this_fold[[2]]$.row_id
        }
      
      train_ids <- train_ids[
        train_ids >= 1 &
          train_ids <= nrow(cv_dat)
      ]
      
      test_ids <- test_ids[
        test_ids >= 1 &
          test_ids <= nrow(cv_dat)
      ]
      
      if (
        length(train_ids) == 0 ||
        length(test_ids) == 0
      ) {
        next
      }
      
      train_dat <- cv_dat[
        train_ids,
        ,
        drop = FALSE
      ]
      
      test_dat <- cv_dat[
        test_ids,
        ,
        drop = FALSE
      ]
      
      if (
        length(unique(train_dat$presence)) < 2 ||
        length(unique(test_dat$presence)) < 2
      ) {
        next
      }
      
      # Hyperparameter tuning
      
      for (mtry in cfg$rf_grid_mtry) {
        
        for (mn in cfg$rf_grid_min_node) {
          
          for (sf in cfg$rf_grid_sample_frac) {
            
            fit <- ranger::ranger(
              presence ~ .,
              data = transform(
                train_dat,
                presence = factor(
                  presence,
                  levels = c(0, 1)
                )
              ),
              probability = TRUE,
              num.trees = 500,
              mtry = min(
                mtry,
                length(final_predictors)
              ),
              min.node.size = mn,
              sample.fraction = sf,
              importance = "permutation",
              respect.unordered.factors = "order",
              classification = TRUE
            )
            
            p_test <- get_ranger_prob(
              fit,
              transform(
                test_dat,
                presence = factor(
                  presence,
                  levels = c(0, 1)
                )
              )
            )
            
            auc_val <- calc_auc(
              test_dat$presence,
              p_test
            )
            
            thr <- calc_optimal_threshold(
              truth = test_dat$presence,
              prob = p_test,
              method = "youden"
            )
            
            met <- calc_binary_metrics(
              obs = test_dat$presence,
              prob = p_test,
              thr = thr
            )
            
            fold_metrics[[length(fold_metrics) + 1L]] <- data.frame(
              block_size = bs,
              fold = fold_id,
              mtry = mtry,
              min_node = mn,
              sample_fraction = sf,
              AUC = auc_val,
              threshold = thr,
              sensitivity = met$sensitivity,
              specificity = met$specificity,
              TSS = met$TSS,
              accuracy = met$accuracy
            )
          }
        }
      }
    }
    
    if (length(fold_metrics) == 0)
      next
    
    cv_df <- dplyr::bind_rows(fold_metrics)
    
    cv_results[[as.character(bs)]] <- cv_df
    
    block_checks_df[
      block_checks_df$block_size == bs,
      "AUC_mean"
    ] <- mean(
      cv_df$AUC,
      na.rm = TRUE
    )
    
    block_checks_df[
      block_checks_df$block_size == bs,
      "TSS_mean"
    ] <- mean(
      cv_df$TSS,
      na.rm = TRUE
    )
  }
  
  # Select best block size
  
  valid <- which(
    !is.na(block_checks_df$TSS_mean)
  )
  
  if (length(valid) > 0) {
    
    ord <- order(
      block_checks_df$TSS_mean[valid],
      block_checks_df$AUC_mean[valid],
      decreasing = TRUE
    )
    
    best_block_size <-
      block_checks_df$block_size[valid][ord][1]
  }
  
  message(
    "Selected best_block_size: ",
    best_block_size,
    " m"
  )
  
  if (is.na(best_block_size)) {
    best_block_size <- cfg$block_size_m
  }
  
  glo_cv_results <- cv_results
  glo_block_checks_df <- block_checks_df
  glo_best_block_size <- best_block_size
  
  #############################################################################
  # 4.8 Final global RF fit
  #############################################################################
  
  glo_final_dat <- glo_full_data_model[, c("presence", final_predictors), drop = FALSE]
  glo_final_dat$presence <- as.factor(glo_final_dat$presence)
  
  glo_final_model <- ranger::ranger(
    presence ~ .,
    data = glo_final_dat,
    probability = TRUE,
    num.trees = 1000,
    mtry = min(3, length(final_predictors)),
    min.node.size = 1,
    sample.fraction = 0.632,
    importance = "permutation",
    respect.unordered.factors = "order",
    classification = TRUE
  )
  
  glo_train_prob <- get_ranger_prob(glo_final_model, glo_final_dat)
  glo_auc_train <- calc_auc(glo_final_dat$presence, glo_train_prob)
  glo_optimal_threshold <- calc_optimal_threshold(glo_final_dat$presence, glo_train_prob)
  glo_training_metrics <- calc_binary_metrics(glo_final_dat$presence, glo_train_prob, glo_optimal_threshold)
  glo_training_metrics$AUC <- glo_auc_train
  
  #############################################################################
  # 4.9 Predict global suitability
  #############################################################################
  
  glo_pred_for_model <- glo_pred_stack[[final_predictors]]
  
  global_suit <- terra::predict(
    glo_pred_for_model,
    glo_final_model,
    type = "response",
    index = 2,
    na.rm = TRUE,
    filename = file.path(ras_dir, "global_suitability.tif"),
    overwrite = TRUE,
    wopt = list(datatype = "FLT4S", gdal = c("COMPRESS=NONE"))# or: gdal = c("COMPRESS=LZW"), LZW reduces file size substantially
  )
  
  names(global_suit) <- "suitability"
  
  if (file.exists(cfg$boundary_file)) {
    study_bnd <- sf::st_read(cfg$boundary_file, quiet = TRUE)
    study_bnd <- sf::st_make_valid(study_bnd)
    if (!is.na(sf::st_crs(study_bnd))) {
      study_bnd <- sf::st_transform(study_bnd, terra::crs(global_suit))
      study_vect <- terra::vect(study_bnd)
      glo_maskreg_suit <- terra::mask(terra::crop(global_suit, study_vect), study_vect)
      terra::writeRaster(
        glo_maskreg_suit,
        file.path(ras_dir, "study_area_suitability.tif"),
        overwrite = TRUE
      )
    }
  }
  
  #############################################################################
  # 4.10 Save global SDM objects
  #############################################################################
  
  saveRDS(glo_final_model, file.path(tables_dir, "global_rf_model.rds"))
  saveRDS(glo_training_metrics, file.path(tables_dir, "global_training_metrics.rds"))
  saveRDS(final_predictors, file.path(tables_dir, "global_selected_predictors.rds"))
  saveRDS(glo_optimal_threshold, file.path(tables_dir, "global_optimal_threshold.rds"))
  
  glo_cv_summary_all <- bind_rows(lapply(names(glo_cv_results), function(nm) {
    x <- glo_cv_results[[nm]]
    if (is.null(x) || nrow(x) == 0) return(NULL)
    x %>%
      summarise(
        block_size = as.numeric(nm),
        AUC_mean = mean(AUC, na.rm = TRUE),
        AUC_sd = sd(AUC, na.rm = TRUE),
        TSS_mean = mean(TSS, na.rm = TRUE),
        TSS_sd = sd(TSS, na.rm = TRUE)
      )
  }))
  
  saveRDS(glo_cv_results, file.path(tables_dir, "global_cv_results.rds"))
  saveRDS(glo_cv_summary_all, file.path(tables_dir, "global_cv_summary.rds"))
  
  message("Global SDM completed.")
}

#############################################################################
# 5. LOCAL NESTED SDM MODULE
#############################################################################

if (isTRUE(cfg$run_local_sdm)) {
  
  message("Running local nested SDM module...")
  
  set.seed(cfg$seed_local)
  
  #############################################################################
  # 5.1 Read occurrence data and clip to target region
  #############################################################################
  
# reg_ prefix stands for "regional"  
  
  message("Reading occurrence data...")
  
  reg_occ_file <- cfg$occurrence_file_regional
  
  # a) Try TSV first (your file appears tab-delimited)
  reg_occ_raw <- tryCatch(
    readr::read_tsv(reg_occ_file, show_col_types = FALSE, progress = FALSE),
    error = function(e) NULL
  )
  
  # b) Fallback CSV
  if (is.null(reg_occ_raw) || ncol(reg_occ_raw) < 5) {
    reg_occ_raw <- tryCatch(
      readr::read_csv(reg_occ_file, show_col_types = FALSE, progress = FALSE),
      error = function(e) NULL
    )
  }
  
  # c) Fallback base with no quote handling if still broken
  if (is.null(reg_occ_raw) || ncol(reg_occ_raw) < 5) {
    reg_occ_raw <- read.table(
      reg_occ_file,
      header = TRUE,
      sep = "\t",
      quote = "",
      fill = TRUE,
      comment.char = "",
      stringsAsFactors = FALSE,
      check.names = FALSE
    )
  }
  
  if (is.null(reg_occ_raw) || nrow(reg_occ_raw) == 0) {
    stop("Could not read occurrence file or file has zero rows.")
  }
  
  # keep original + cleaned names
  reg_occ <- as.data.frame(reg_occ_raw)
  nm_orig <- names(reg_occ)
  nm_clean <- janitor::make_clean_names(nm_orig)
  
  # original -> clean
  names(reg_occ) <- nm_clean
  
  # Required columns after cleaning
  # countryCode -> country_code
  # decimalLatitude -> decimal_latitude
  # decimalLongitude -> decimal_longitude
  need <- c("country_code", "decimal_latitude", "decimal_longitude")
  miss <- setdiff(need, names(reg_occ))
  if (length(miss) > 0) {
    stop("Missing required columns after cleaning: ", paste(miss, collapse = ", "))
  }
  
  reg_occ <- reg_occ %>%
    dplyr::mutate(
      country_code = toupper(trimws(as.character(country_code))),
      lon = suppressWarnings(as.numeric(decimal_longitude)),
      lat = suppressWarnings(as.numeric(decimal_latitude))
    ) %>%
    dplyr::filter(
      country_code == "CH",
      is.finite(lon), is.finite(lat),
      lon >= -180, lon <= 180,
      lat >= -90,  lat <= 90
    ) %>%
    dplyr::distinct(lon, lat, .keep_all = TRUE)
  
  if (nrow(reg_occ) == 0) stop("No valid occurrence point within target country after cleaning.")
  
  # Build pres_sf
  reg_pres_sf <- sf::st_as_sf(reg_occ, coords = c("lon", "lat"), crs = 4326, remove = FALSE)
  reg_pres_sf$presence <- 1L
  
  # Clip to study area
  study_sf <- sf::st_as_sf(study_vect)
  reg_pres_sf <- sf::st_transform(reg_pres_sf, sf::st_crs(study_sf))
  reg_pres_sf <- reg_pres_sf[lengths(sf::st_intersects(reg_pres_sf, study_sf)) > 0, , drop = FALSE]
  
  if (nrow(reg_pres_sf) == 0) {
    stop("Occurrence points found, but none intersect study area. Check study_vect CRS/extent.")
  }
  
  cat("Presences retained (target country + inside study area):", nrow(reg_pres_sf), "\n")
  
  
  ###############################################################################
  # 5.2 Build regional predictors (regional extent/mask, aligned geometry)
  ###############################################################################
  
  # glo_maskreg_suit is expected from previous section (global)
  # otherwise import study_area_suitability.tif from path stored in cfg$coarse_suit_file
  
  coarse_suit_r <- glo_maskreg_suit
  names(coarse_suit_r) <- "coarse_suitability"
  
  #landuse for target country / study region to be imported
  landuse_file <- cfg$regional_landuse_file
  landuse <- terra::rast(landuse_file)
  
  # Check crs and ensure landuse aligns to coarse suitability geometry

  if (terra::crs(landuse) != terra::crs(cfg$regional_target_crs)) {
    landuse <- terra::project(landuse, cfg$regional_target_crs, method = "near")
  }
  
  if (terra::crs(coarse_suit_r) != terra::crs(cfg$regional_target_crs)) {
    coarse_suit_r <- terra::project(coarse_suit_r, cfg$regional_target_crs, method = "bilinear")
  }
  
  if (!terra::compareGeom(landuse, coarse_suit_r, stopOnError = FALSE)) {
    coarse_suit_r <- terra::resample(coarse_suit_r, landuse, method = "bilinear")
  }
    
  # Build one-hot land-use dummies from observed classes
  landuse_vals <- terra::values(landuse, mat = FALSE)
  
  lu_ids <- sort(unique(stats::na.omit(as.integer(landuse_vals))))
  if (length(lu_ids) == 0) stop("No valid land-use classes found in landuse raster.")
  lu_ids <- setdiff(lu_ids, 0)
  
  lu_dummy_list <- lapply(lu_ids, function(id) {
    terra::ifel(landuse == id, 1, 0)
  })
  
  lu_dummy <- terra::rast(lu_dummy_list)
  names(lu_dummy) <- paste0("lu_", lu_ids)
  
  # Regional predictor stack
  reg_pred_stack <- c(coarse_suit_r, lu_dummy)
  reg_predictors <- names(reg_pred_stack)
  
  # Restrict to study region ( mask with study_vect)
  if (terra::crs(study_vect) != terra::crs(cfg$regional_target_crs)) {
    study_vect_proj <- terra::project(study_vect, cfg$regional_target_crs)
  }

  reg_pred_stack <- terra::crop(reg_pred_stack, study_vect_proj, snap = "out")
  reg_pred_stack <- terra::mask(reg_pred_stack, study_vect_proj)
  
  ###############################################################################
  # 5.2 Presence + background sampling + predictor extraction
  ###############################################################################
  
  # Preconditions
  if (!inherits(reg_pres_sf, "sf")) stop("pres_sf must be an sf object.")
  if (!inherits(study_vect_proj, "SpatVector")) stop("study_vect must be a terra SpatVector.")
  if (!inherits(reg_pred_stack, "SpatRaster")) stop("regional_pred_stack must be a terra SpatRaster.")
  
  # Presence label
  if (!"presence" %in% names(reg_pres_sf)) reg_pres_sf$presence <- 1L
  reg_pres_sf$presence <- 1L
  
  # IMPORTANT: fail early if empty upstream
  if (nrow(reg_pres_sf) == 0) {
    stop("pres_sf is empty before local assembly. Fix upstream occurrence filtering/creation.")
  }
  
  # CRS checks
  if (is.na(sf::st_crs(reg_pres_sf))) stop("pres_sf has no CRS.")
  if (is.na(terra::crs(study_vect_proj))) stop("study_vect has no CRS.")
  if (is.na(terra::crs(reg_pred_stack))) stop("regional_pred_stack has no CRS.")
  
  # Harmonize CRS 
  if (terra::crs(reg_pres_sf) != terra::crs(cfg$regional_target_crs)) {
    reg_pres_sf <- sf::st_transform(reg_pres_sf, cfg$regional_target_crs)
  }
  
  if (terra::crs(study_vect_proj) != terra::crs(cfg$regional_target_crs)) {
    study_vect_proj <- terra::project(study_vect_proj, cfg$regional_target_crs)
  }
  
  if (terra::crs(reg_pred_stack) != terra::crs(cfg$regional_target_crs)) {
    reg_pred_stack <- terra::project(reg_pred_stack, cfg$regional_target_crs)
  }

  study_sf <- sf::st_as_sf(study_vect_proj)
  inside_idx <- lengths(sf::st_intersects(reg_pres_sf, study_sf)) > 0
  reg_pres_sf <- reg_pres_sf[inside_idx, , drop = FALSE]
  if (nrow(reg_pres_sf) == 0) stop("No presence points inside study area after CRS transform/intersection.")
  
  # Remove duplicate coordinates
  reg_pres_xy <- sf::st_coordinates(reg_pres_sf)
  dup <- duplicated(data.frame(x = reg_pres_xy[,1], y = reg_pres_xy[,2]))
  reg_pres_sf <- reg_pres_sf[!dup, , drop = FALSE]
  if (nrow(reg_pres_sf) == 0) stop("No unique presence points remain after duplicate removal.")
  
  n_row_reg_final_pres <- nrow(reg_pres_sf)
  n_pres <- nrow(reg_pres_sf)
  message("Presence count (inside study area, unique): ", n_pres)
  
  # Valid mask = cells with all predictors non-NA, within study area
  valid_mask <- !is.na(reg_pred_stack[[1]])
  if (terra::nlyr(reg_pred_stack) > 1) {
    for (i in 2:terra::nlyr(reg_pred_stack)) {
      valid_mask <- valid_mask & !is.na(reg_pred_stack[[i]])
    }
  }
  
  valid_mask <- terra::ifel(valid_mask, 1, 0)
  valid_mask <- terra::mask(valid_mask, study_vect_proj)
  
  
  # Optional exclusion buffer around presences
  reg_pres_v <- terra::vect(reg_pres_sf)
  if (!is.null(cfg$regional_bg_buffer_m) &&
      length(cfg$regional_bg_buffer_m) > 0 &&
      is.finite(cfg$regional_bg_buffer_m[1]) &&
      cfg$regional_bg_buffer_m[1] > 0) {
    reg_pres_buffer <- terra::buffer(reg_pres_v, width = cfg$regional_bg_buffer_m[1])
    valid_mask  <- terra::mask(valid_mask, reg_pres_buffer, inverse = TRUE)
  }
  
  reg_eligible_cells <- terra::global(valid_mask, "sum", na.rm = TRUE)[1,1]
  if (is.na(reg_eligible_cells) || reg_eligible_cells < n_pres) {
    stop(sprintf("Not enough eligible background cells (%s) for n_pres=%s.", reg_eligible_cells, n_pres))
  }
  
  # Sample background: 1:1 with presence
  reg_bg_pts <- terra::spatSample(
    x = valid_mask, size = n_pres, method = "random",
    na.rm = TRUE, as.points = TRUE, values = FALSE
  )
  if (is.null(reg_bg_pts) || terra::nrow(reg_bg_pts) != n_pres) {
    stop(sprintf("Background sampling failed or returned wrong count (%s vs %s).",
                 ifelse(is.null(bg_pts), 0, terra::nrow(bg_pts)), n_pres))
  }
  
  reg_bg_sf <- sf::st_as_sf(reg_bg_pts)
  if (is.na(sf::st_crs(reg_bg_sf))) stop("bg_sf has no CRS.")
  if (sf::st_crs(reg_bg_sf)$wkt != sf::st_crs(reg_pres_sf)$wkt) {
    reg_bg_sf <- sf::st_transform(reg_bg_sf, sf::st_crs(pres_sf))
  }
  reg_bg_sf$presence <- 0L
  
  # Predictor extraction
  reg_pres_ext <- terra::extract(reg_pred_stack, terra::vect(reg_pres_sf))
  reg_bg_ext   <- terra::extract(reg_pred_stack, terra::vect(reg_bg_sf))
  reg_pres_ext <- as.data.frame(reg_pres_ext)[, -1, drop = FALSE]  # drop ID
  reg_bg_ext   <- as.data.frame(reg_bg_ext)[, -1, drop = FALSE]
  
  reg_pres_df <- cbind(data.frame(presence = 1L), reg_pres_ext)
  reg_bg_df   <- cbind(data.frame(presence = 0L), reg_bg_ext)
  reg_full_data_model <- dplyr::bind_rows(reg_pres_df, reg_bg_df)
  
  needed_cols <- c("presence", reg_predictors)
  missing_cols <- setdiff(needed_cols, names(reg_full_data_model))
  if (length(missing_cols) > 0) {
    stop("Missing columns after extraction: ", paste(missing_cols, collapse = ", "))
  }
  reg_full_data_model <- reg_full_data_model[, needed_cols, drop = FALSE]
  
  message("\nClass balance BEFORE complete.cases:")
  print(table(reg_full_data_model$presence, useNA = "ifany"))
  
  reg_full_data_model <- reg_full_data_model[stats::complete.cases(reg_full_data_model), , drop = FALSE]
  
  tab_local <- table(reg_full_data_model$presence)
  message("\nClass balance AFTER complete.cases:")
  print(tab_local)
  
  if (length(tab_local) < 2 || any(tab_local == 0)) {
    stop("Local assembly failed: single class after extraction/cleaning.")
  }
  if (nrow(reg_full_data_model) < 20) {
    stop("Too few local modeling records after extraction.")
  }
  
  # Strict re-balance after NA filtering
  if (!all(c("0","1") %in% names(tab_local)) || tab_local["0"] != tab_local["1"]) {
    n_min <- min(tab_local)
    set.seed(if (!is.null(cfg$seed)) cfg$seed else 42)
    i1 <- which(reg_full_data_model$presence == 1L)
    i0 <- which(reg_full_data_model$presence == 0L)
    keep <- c(sample(i1, n_min), sample(i0, n_min))
    reg_full_data_model <- reg_full_data_model[keep, , drop = FALSE]
    message(sprintf("Rebalanced to 1:1 with n=%s per class.", n_min))
    print(table(reg_full_data_model$presence))
  }
  
  ###############################################################################
  # 5.3 Regional spatial CV and tuning
  ###############################################################################
  
  set.seed(cfg$seed_local)
  
  # Build CV point object from pres/bg used above
  cv_pts <- rbind(
    sf::st_as_sf(data.frame(presence = 1L), geometry = sf::st_geometry(reg_pres_sf)),
    sf::st_as_sf(data.frame(presence = 0L), geometry = sf::st_geometry(reg_bg_sf))
  )
  sf::st_crs(cv_pts) <- sf::st_crs(reg_pres_sf)
  
  # Extract predictors for exact row sync
  cv_ext <- terra::extract(reg_pred_stack, terra::vect(cv_pts))
  cv_ext <- as.data.frame(cv_ext)[, -1, drop = FALSE]
  cv_dat <- cbind(sf::st_drop_geometry(cv_pts), cv_ext)
  cv_dat <- cv_dat[, c("presence", reg_predictors), drop = FALSE]
  
  cc_cv <- stats::complete.cases(cv_dat)
  cv_dat <- cv_dat[cc_cv, , drop = FALSE]
  cv_pts <- cv_pts[cc_cv, , drop = FALSE]
  cv_pts$.row_id <- seq_len(nrow(cv_pts))
  cv_pts$presence <- cv_dat$presence
  
  cv_results <- list()
  
  block_checks_df <- data.frame(
    block_size = cfg$regional_block_sizes_m,
    AUC_mean   = NA_real_,
    TSS_mean   = NA_real_
  )
  
  best_block <- cfg$regional_block_size_m
  
  for (bs in cfg$regional_block_sizes_m) {
    message("Checking local block size: ", bs, " m")
    
    cv_obj <- tryCatch(
      blockCV::cv_spatial(
        x = cv_pts, column = "presence", k = 5, size = bs,
        selection = "random", iteration = 100, hexagon = FALSE,
        plot = FALSE, progress = FALSE
      ),
      error = function(e) {
        warning("cv_spatial failed for block size ", bs, ": ", conditionMessage(e))
        NULL
      }
    )
    if (is.null(cv_obj) || is.null(cv_obj$folds_list) || length(cv_obj$folds_list) == 0) next
    
    fold_tbl <- list()
    for (fold_id in seq_along(cv_obj$folds_list)) {
      this_fold <- cv_obj$folds_list[[fold_id]]
      if (length(this_fold) < 2) next
      
      train_ids <- if (is.numeric(this_fold[[1]])) as.integer(this_fold[[1]]) else this_fold[[1]]$.row_id
      test_ids  <- if (is.numeric(this_fold[[2]])) as.integer(this_fold[[2]]) else this_fold[[2]]$.row_id
      
      train_ids <- train_ids[train_ids >= 1 & train_ids <= nrow(cv_dat)]
      test_ids  <- test_ids[test_ids >= 1 & test_ids <= nrow(cv_dat)]
      if (length(train_ids) == 0 || length(test_ids) == 0) next
      
      train_dat <- cv_dat[train_ids, , drop = FALSE]
      test_dat  <- cv_dat[test_ids, , drop = FALSE]
      
      if (length(unique(train_dat$presence)) < 2 || length(unique(test_dat$presence)) < 2) next
      
      fit <- ranger::ranger(
        presence ~ .,
        data = transform(train_dat, presence = factor(presence, levels = c(0,1))),
        probability = TRUE,
        num.trees = 500,
        mtry = min(3, length(reg_predictors)),
        min.node.size = 1,
        sample.fraction = 0.632,
        importance = "permutation",
        classification = TRUE
      )
      
      p_test <- get_ranger_prob(fit, transform(test_dat, presence = factor(presence, levels = c(0,1))))
      thr <- calc_optimal_threshold(test_dat$presence, p_test)
      met <- calc_binary_metrics(test_dat$presence, p_test, thr)
      
      fold_tbl[[length(fold_tbl) + 1L]] <- data.frame(
        block_size = bs, fold = fold_id,
        AUC = calc_auc(test_dat$presence, p_test),
        threshold = thr,
        sensitivity = met$sensitivity,
        specificity = met$specificity,
        TSS = met$TSS,
        accuracy = met$accuracy
      )
    }
    
    if (length(fold_tbl) == 0) next
    cv_df <- dplyr::bind_rows(fold_tbl)
    cv_results[[as.character(bs)]] <- cv_df
    block_checks_df[block_checks_df$block_size == bs, "AUC_mean"] <- mean(cv_df$AUC, na.rm = TRUE)
    block_checks_df[block_checks_df$block_size == bs, "TSS_mean"] <- mean(cv_df$TSS, na.rm = TRUE)
  }
  
  valid <- which(!is.na(block_checks_df$TSS_mean))
  if (length(valid) > 0) {
    ord <- order(block_checks_df$TSS_mean[valid], block_checks_df$AUC_mean[valid], decreasing = TRUE)
    best_block_size <- block_checks_df$block_size[valid][ord][1]
  }
  message("Selected regional_best_block: ", best_block_size, "m")
  
  if (is.na(best_block_size)) {
    best_block_size <- cfg$regional_block_size_m
  }
  
  reg_cv_results <- cv_results
  reg_block_checks_df <- block_checks_df
  reg_best_block_size <- best_block_size
  
  ###############################################################################
  # 5.4 Fit final regional model
  ###############################################################################
  
  reg_final_dat <- reg_full_data_model[, c("presence", reg_predictors), drop = FALSE]
  reg_final_dat <- reg_final_dat[stats::complete.cases(reg_final_dat), , drop = FALSE]
  reg_final_dat <- reg_final_dat[reg_final_dat$presence %in% c(0,1), , drop = FALSE]
  
  tab <- table(reg_final_dat$presence)
  print(tab)
  if (length(tab) < 2 || any(tab == 0)) stop("Regional model aborted: single-class training data.")
  
  reg_final_dat$presence <- factor(reg_final_dat$presence, levels = c(0,1))
  
  set.seed(cfg$seed_local)
  reg_final_model <- ranger::ranger(
    presence ~ .,
    data = reg_final_dat,
    probability = TRUE,
    num.trees = 500,
    mtry = min(3, length(reg_predictors)),
    min.node.size = 1,
    sample.fraction = 0.632,
    importance = "permutation",
    classification = TRUE
  )
  
  reg_train_prob <- get_ranger_prob(reg_final_model, reg_final_dat)
  reg_auc_train <- calc_auc(reg_final_dat$presence, reg_train_prob)
  reg_optimal_threshold <- calc_optimal_threshold(reg_final_dat$presence, reg_train_prob)
  reg_training_metrics <- calc_binary_metrics(reg_final_dat$presence, reg_train_prob, reg_optimal_threshold)
  reg_training_metrics$AUC <- reg_auc_train
    
  ###############################################################################
  # 5.5 Predict regional suitability
  ###############################################################################
  
  reg_pred_keep <- intersect(reg_predictors, names(reg_pred_stack))
  if (length(reg_pred_keep) == 0) stop("No predictor layers available for local prediction.")
  reg_pred_for_model <- reg_pred_stack[[reg_pred_keep]]
  
  regional_suit_all <- terra::predict(
    reg_pred_for_model,
    reg_final_model,
    type = "response",
    na.rm = TRUE,
    filename = file.path(ras_dir, "regional_probability_allclasses.tif"),
    overwrite = TRUE,
    wopt = list(datatype = "FLT4S", gdal = c("COMPRESS=NONE"))# or: gdal = c("COMPRESS=LZW"), LZW reduces file size substantially
  )
  
  nm <- names(regional_suit_all)
  message("Predicted suitability layer names: ", paste(nm, collapse = ", "))
  
  regional_suit_presence <- terra::predict(
    reg_pred_for_model,
    reg_final_model,
    type = "response",
    index = 2,
    na.rm = TRUE,
    filename = file.path(ras_dir, "regional_probability_presence.tif"),
    overwrite = TRUE,
    wopt = list(datatype = "FLT4S", gdal = c("COMPRESS=NONE"))# or: gdal = c("COMPRESS=LZW"), LZW reduces file size substantially
  )  
  
  local_pred <- regional_suit_presence
  names(local_pred) <- "probability"
  
  terra::writeRaster(
    local_pred,
    filename = file.path(ras_dir, "regional_suitability_presence.tif"),
    overwrite = TRUE
  )
  
  s <- terra::global(local_pred, c("min","max","mean"), na.rm = TRUE)
  print(s)
  if (isTRUE(all.equal(s[1,"min"], s[1,"max"]))) {
    stop("Degenerate regional suitability raster (min == max).")
  }
  
  local_class <- terra::classify(
    local_pred,
    rcl = matrix(
      c(-Inf, reg_optimal_threshold, 0,
        reg_optimal_threshold, Inf, 1),
      ncol = 3, byrow = TRUE
    ),
    include.lowest = TRUE,
    right = FALSE,
    filename = file.path(ras_dir, "regional_suitability_binary.tif"),
    overwrite = TRUE
  )
  
  names(local_class) <- "binary_suitability"
  sb <- terra::global(local_class, c("min","max","mean", "sum"), na.rm = TRUE)
  message("local_class summary -> min=", sb[1,1], ", max=", sb[1,2], ", mean=", sb[1,3], ", sum=", sb[1,4])
  
  
  ###############################################################################
  # 5.6 Save regional outputs
  ###############################################################################
  
  saveRDS(reg_final_model, file.path(tables_dir, "regional_rf_model.rds"))
  saveRDS(reg_training_metrics, file.path(tables_dir, "regional_training_metrics.rds"))
  saveRDS(reg_predictors, file.path(tables_dir, "regional_selected_predictors.rds"))
  saveRDS(reg_optimal_threshold,  file.path(tables_dir, "regional_optimal_threshold.rds"))
  
  reg_cv_summary_all <- bind_rows(lapply(names(reg_cv_results), function(nm) {
    x <- reg_cv_results[[nm]]
    if (is.null(x) || nrow(x) == 0) return(NULL)
    x %>%
      summarise(
        block_size = as.numeric(nm),
        AUC_mean = mean(AUC, na.rm = TRUE),
        AUC_sd = sd(AUC, na.rm = TRUE),
        TSS_mean = mean(TSS, na.rm = TRUE),
        TSS_sd = sd(TSS, na.rm = TRUE)
      )
  }))
  
  saveRDS(reg_cv_results, file.path(tables_dir, "regional_cv_results.rds"))
  saveRDS(reg_cv_summary_all, file.path(tables_dir, "regional_cv_summary.rds"))
   
  message("regional SDM completed.")

}

