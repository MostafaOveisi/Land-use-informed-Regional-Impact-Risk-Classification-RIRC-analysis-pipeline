if (isTRUE(cfg$run_rirc)) {
  message("Running RIRC module...")
  
  # ---------------------------------------------------------------------------
  # 8.0 Packages + utilities
  # ---------------------------------------------------------------------------
  pkgs_needed <- c("terra", "sf", "dplyr", "tidyr", "ggplot2", "tibble")
  miss <- pkgs_needed[!vapply(pkgs_needed, requireNamespace, logical(1), quietly = TRUE)]
  if (length(miss) > 0) stop("Missing required package(s): ", paste(miss, collapse = ", "))
  
  terra::terraOptions(overwrite = TRUE)
  
  `%||%` <- function(a, b) if (!is.null(a)) a else b
  
  sanitize_name <- function(x) {
    x <- gsub("[^[:alnum:]_\\-]+", "_", as.character(x))
    x <- gsub("_+", "_", x)
    x <- gsub("^_|_$", "", x)
    x
  }
  
  # requested title formatter
  pretty_title <- function(x) {
    x <- gsub("\\.+", " ", x)
    x <- gsub("\\s+", " ", x)
    trimws(x)
  }
  
  # ---------------------------------------------------------------------------
  # 8.0a File-locking helpers
  # ---------------------------------------------------------------------------
  safe_remove_raster <- function(path, tries = 15, wait = 0.3) {
    targets <- c(path, paste0(path, ".aux.xml"), paste0(path, ".ovr"), paste0(path, ".msk"))
    targets <- unique(targets[file.exists(targets)])
    if (length(targets) == 0) return(invisible(TRUE))
    for (i in seq_len(tries)) {
      ok_all <- TRUE
      for (f in targets) {
        if (file.exists(f)) {
          ok <- suppressWarnings(try(file.remove(f), silent = TRUE))
          if (inherits(ok, "try-error") || !isTRUE(ok)) ok_all <- FALSE
        }
      }
      if (ok_all && !any(file.exists(targets))) return(invisible(TRUE))
      gc()
      try(terra::tmpFiles(remove = TRUE), silent = TRUE)
      Sys.sleep(wait)
    }
    warning("Could not remove locked raster or sidecar(s): ", path)
    invisible(FALSE)
  }
  
  safe_rename <- function(from, to, tries = 15, wait = 0.3) {
    if (!file.exists(from)) stop("Temp file missing, cannot rename: ", from)
    if (file.exists(to) || file.exists(paste0(to, ".aux.xml")) || file.exists(paste0(to, ".ovr")) || file.exists(paste0(to, ".msk"))) {
      safe_remove_raster(to, tries = tries, wait = wait)
    }
    for (i in seq_len(tries)) {
      ok <- suppressWarnings(try(file.rename(from, to), silent = TRUE))
      if (!inherits(ok, "try-error") && isTRUE(ok) && file.exists(to)) return(invisible(TRUE))
      gc(); Sys.sleep(wait)
    }
    ok2 <- suppressWarnings(try(file.copy(from, to, overwrite = TRUE), silent = TRUE))
    if (!inherits(ok2, "try-error") && isTRUE(ok2) && file.exists(to)) {
      suppressWarnings(try(file.remove(from), silent = TRUE))
      return(invisible(TRUE))
    }
    stop("Could not move temp file to final destination:\nFROM: ", from, "\nTO: ", to)
  }
  
  # ---------------------------------------------------------------------------
  # 8.1 RIRC class definitions
  # ---------------------------------------------------------------------------
  class_ids <- 0:6
  class_labels <- c(
    "No documented impact (DD/NA)",
    "Very Low", "Low", "Moderate", "High", "Very High", "Extreme"
  )
  class_colors <- c(
    "No documented impact (DD/NA)" = "#BDBDBD",
    "Very Low"                     = "#B0C4B1",
    "Low"                          = "#6B8E23",
    "Moderate"                     = "#FFFF00",
    "High"                         = "#FFA500",
    "Very High"                    = "#FF0000",
    "Extreme"                      = "#8B0000"
  )
  
  # keep separate (for suitability map products only, not RIRC class maps)
  suitability_class_levels <- c(
    "Unsuitable habitat (0.0-0.527)",
    "Marginal suitability (0.527-0.595)",
    "Moderately suitable (0.595-0.730)",
    "Highly suitable (0.730-0.865)",
    "Optimal habitat (0.865-1.0)"
  )
  suitability_class_colors <- c(
    "Unsuitable habitat (0.0-0.527)" = "#F5F5DC",
    "Marginal suitability (0.527-0.595)" = "#556B2F",
    "Moderately suitable (0.595-0.730)" = "#B8860B",
    "Highly suitable (0.730-0.865)" = "#FFA500",
    "Optimal habitat (0.865-1.0)" = "#FF0000"
  )
  
  category_mapping <- c("DD" = 0, "MC" = 1, "MN" = 2, "MO" = 3, "MR" = 4, "MV" = 5)
  
  # ---------------------------------------------------------------------------
  # 8.2 Land-use impact table
  # (Example using Sorghum halepense in Switzerland. Update the block below for your target species and location)
  # ---------------------------------------------------------------------------
  land_use_data_frame <- data.frame(
    LU_ID = c(1,2,3,4,5,10,11,12,13,14,15,16,17,111,112,113,114,115,116,117,118,204),
    LU_category = c(
      "Industrial areas","Built-up areas","Transportation areas","Special urban areas","Green spaces and recreational areas",
      "Forests (except brush forests)","Brush forests","Other wood surfaces","Lakes","Rivers & River shores","Unproductive vegetation",
      "Bare land","Glaciers, snow","Orchards","Vineyards","Horticulture","Arable land","Natural meadows","Farm pastures","Mountain meadows",
      "Alpine pastures","Built-up agri"
    ),
    Management_costs     = c("DD","DD","MN","DD","MN","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MN","DD","DD","DD","DD","DD"),
    Toxicity             = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MR","DD","DD","DD"),
    Structural_impact    = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MO","DD","DD","DD","DD","DD","DD","MO","DD","DD","DD","DD"),
    Disease_transmission = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MN","DD","DD","DD","DD","DD"),
    Hybridization        = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD"),
    Chemical_impact      = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MO","DD","DD","DD","DD","DD","DD","MO","MO","DD","DD","DD"),
    Competition          = c("DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","MO","DD","DD","DD","DD","DD","MO","MO","MO","DD","DD","DD"),
    Human_health         = c("DD","DD","MN","DD","MN","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD","DD"),
    stringsAsFactors = FALSE
  )
  
  # ---------------------------------------------------------------------------
  # 8.3 Alignment
  # ---------------------------------------------------------------------------
  if (!exists("landuse") && file.exists(cfg$regional_landuse_file)) landuse <- terra::rast(cfg$regional_landuse_file)
  if (!exists("study_bnd") && file.exists(cfg$boundary_file))    study_bnd <- sf::st_read(cfg$boundary_file, quiet = TRUE)
  if (!exists("study_vect")) study_vect <- terra::vect(sf::st_make_valid(study_bnd))
  
  if (!exists("local_pred") && exists("regional_suit_presence"))  local_pred <- regional_suit_presence
  if (!exists("local_pred") && exists("glo_maskreg_suit")) local_pred <- glo_maskreg_suit
  
  if (!exists("local_pred")) stop("No suitability raster available for RIRC analysis.")
  if (!exists("landuse"))    stop("Land-use raster not found and cfg$local_landuse_file not readable.")
  if (!exists("study_bnd"))  stop("Boundary object not found and cfg$boundary_file not readable.")
  
  if (is.na(terra::crs(landuse)) || is.na(terra::crs(local_pred))) stop("One or more RIRC raster inputs are missing CRS.")
  
  if (terra::crs(landuse) != cfg$regional_target_crs)    landuse <- terra::project(landuse, cfg$regional_target_crs, method = "near")
  if (terra::crs(local_pred) != cfg$regional_target_crs) local_pred <- terra::project(local_pred, cfg$regional_target_crs, method = "bilinear")
  if (!terra::compareGeom(landuse, local_pred, stopOnError = FALSE)) local_pred <- terra::resample(local_pred, landuse, method = "bilinear")
  if (terra::crs(study_vect) != cfg$regional_target_crs)    study_vect <- terra::project(study_vect, cfg$regional_target_crs)
  
  landuse    <- terra::mask(terra::crop(landuse, study_vect), study_vect)
  local_pred <- terra::mask(terra::crop(local_pred, study_vect), study_vect)
  names(local_pred) <- "Suitability"
  
  # discrete suitability for RIRC weighting (1..5)
  suitability_rirc <- terra::classify(
    local_pred,
    rcl = matrix(c(
      -Inf, 0.527, 1,
      0.527, 0.595, 2,
      0.595, 0.730, 3,
      0.730, 0.865, 4,
      0.865, Inf,   5
    ), byrow = TRUE, ncol = 3),
    include.lowest = TRUE,
    right = FALSE
  )
  names(suitability_rirc) <- "SuitabilityClass"
  
  # ---------------------------------------------------------------------------
  # 8.4 Impact long + classifier
  # ---------------------------------------------------------------------------
  impact_long <- land_use_data_frame %>%
    tidyr::pivot_longer(
      cols = c(Management_costs, Toxicity, Structural_impact, Disease_transmission,
               Hybridization, Chemical_impact, Competition, Human_health),
      names_to = "ImpactType", values_to = "EICAT"
    ) %>%
    dplyr::mutate(
      EICAT = toupper(trimws(EICAT)),
      ImpactScore = unname(category_mapping[EICAT])
    )
  
  if (any(is.na(impact_long$ImpactScore))) stop("Unknown EICAT codes detected in the impact table.")
  
  title_lookup <- c(
    "Chemical_impact" = "Chemical Impact",
    "Competition" = "Competition",
    "Disease_transmission" = "Disease Transmission",
    "Human_health" = "Human Health",
    "Management_costs" = "Management Cost",
    "Structural_impact" = "Structural Impact",
    "Toxicity" = "Toxicity",
    "Hybridization" = "Hybridization"
  )
  
  # requested thresholds
  classify_weighted_original <- function(r) {
    rcl <- matrix(c(
      -Inf,      0.000001, 0,
      0.000001,  2,        1,
      2,         4,        2,
      4,         9,        3,
      9,         12,       4,
      12,        15,       5,
      15,        Inf,      6
    ), byrow = TRUE, ncol = 3)
    terra::classify(r, rcl = rcl, include.lowest = TRUE, right = FALSE)
  }
  
  save_rirc_map <- function(r_int, title_text, out_png, class_colors, class_labels,
                            map_width = 10, map_height = 7, map_dpi = 300, show_legend = TRUE) {
    df <- as.data.frame(terra::as.int(r_int), xy = TRUE, na.rm = FALSE)
    names(df) <- c("x", "y", "class_val")
    df <- df[!is.na(df$class_val), , drop = FALSE]
    key_vals <- 0:(length(class_labels) - 1)
    df$class_label <- class_labels[match(df$class_val, key_vals)]
    df$class_label <- factor(df$class_label, levels = class_labels)
    
    p <- ggplot2::ggplot(df, ggplot2::aes(x = x, y = y, fill = class_label)) +
      ggplot2::geom_raster(na.rm = TRUE) +
      ggplot2::scale_fill_manual(values = class_colors, breaks = class_labels, limits = class_labels, drop = FALSE, na.value = NA) +
      ggplot2::labs(title = title_text) +
      ggplot2::coord_equal() +
      ggplot2::theme_minimal(base_size = 11) +
      ggplot2::theme(
        axis.title = ggplot2::element_blank(),
        panel.grid = ggplot2::element_blank(),
        plot.title = ggplot2::element_text(face = "bold"),
        legend.position = if (show_legend) "right" else "none"
      )
    
    ggplot2::ggsave(out_png, p, width = map_width, height = map_height, dpi = map_dpi, bg = "white")
    invisible(p)
  }
  
  # ---------------------------------------------------------------------------
  # 8.5 Mechanism-specific maps
  # ---------------------------------------------------------------------------
  impact_types <- c(
    "Management_costs", "Toxicity", "Structural_impact", "Disease_transmission",
    "Hybridization", "Chemical_impact", "Competition", "Human_health"
  )
  
  rirc_maps_dir    <- file.path(maps_dir,   "RIRC")
  rirc_rasters_dir <- file.path(ras_dir,    "RIRC")
  rirc_tables_dir  <- file.path(tables_dir, "RIRC")
  dir.create(rirc_maps_dir, recursive = TRUE, showWarnings = FALSE)
  dir.create(rirc_rasters_dir, recursive = TRUE, showWarnings = FALSE)
  dir.create(rirc_tables_dir, recursive = TRUE, showWarnings = FALSE)
  
  for (imp in impact_types) {
    message("Processing mechanism: ", imp)
    
    plot_title <- unname(title_lookup[imp]); if (is.na(plot_title)) plot_title <- pretty_title(imp)
    imp_clean  <- sanitize_name(imp)
    imp_folder <- file.path(rirc_maps_dir, imp_clean)
    dir.create(imp_folder, recursive = TRUE, showWarnings = FALSE)
    
    sub <- impact_long %>% dplyr::filter(ImpactType == imp) %>% dplyr::select(LU_ID, ImpactScore)
    rcl_impact <- as.matrix(sub)
    
    impact_file   <- file.path(rirc_rasters_dir, paste0("impact_", imp_clean, ".tif"))
    weighted_file <- file.path(rirc_rasters_dir, paste0("weighted_", imp_clean, ".tif"))
    class_file    <- file.path(imp_folder, paste0("RIRC_original_", imp_clean, "_class.tif"))
    map_png       <- file.path(imp_folder, paste0("MAP_RIRC_original_", imp_clean, ".png"))
    
    impact_tmp   <- tempfile(pattern = paste0("impact_", imp_clean, "_"), tmpdir = rirc_rasters_dir, fileext = ".tif")
    weighted_tmp <- tempfile(pattern = paste0("weighted_", imp_clean, "_"), tmpdir = rirc_rasters_dir, fileext = ".tif")
    class_tmp    <- tempfile(pattern = paste0("class_", imp_clean, "_"), tmpdir = imp_folder, fileext = ".tif")
    
    impact_r <- terra::classify(
      landuse, rcl = rcl_impact, others = NA,
      filename = impact_tmp, overwrite = TRUE,
      wopt = list(datatype = "FLT4S", NAflag = -9999, gdal = c("COMPRESS=LZW"))
    )
    
    # weighted product with strict DD handling
    weighted_r <- impact_r * suitability_rirc
    weighted_r <- terra::ifel(impact_r == 0, 0, weighted_r)
    terra::writeRaster(weighted_r, weighted_tmp, overwrite = TRUE, wopt = list(datatype = "FLT4S", NAflag = -9999, gdal = c("COMPRESS=LZW")))
    
    # class + final DD guard
    rirc_original <- classify_weighted_original(weighted_r)
    rirc_original <- terra::ifel(impact_r == 0, 0, rirc_original)
    
    # diagnostics
    message("  Impact freq (", imp, "):");   print(as.data.frame(terra::freq(impact_r, digits = 0)))
    message("  Weighted freq (", imp, "):"); print(as.data.frame(terra::freq(weighted_r, digits = 0)))
    message("  Class freq (", imp, "):");    print(as.data.frame(terra::freq(rirc_original, digits = 0)))
    
    terra::writeRaster(
      rirc_original, filename = class_tmp, overwrite = TRUE,
      wopt = list(datatype = "INT1U", NAflag = 255, gdal = c("COMPRESS=LZW"))
    )
    
    rm(impact_r, weighted_r, rirc_original); gc()
    try(terra::tmpFiles(remove = TRUE), silent = TRUE)
    
    safe_rename(impact_tmp, impact_file)
    safe_rename(weighted_tmp, weighted_file)
    safe_rename(class_tmp, class_file)
    
    r_plot <- terra::rast(class_file)
    save_rirc_map(
      r_int = r_plot,
      title_text = plot_title,
      out_png = map_png,
      class_colors = class_colors,
      class_labels = class_labels,
      map_width = cfg$map_width %||% 10,
      map_height = cfg$map_height %||% 7,
      map_dpi = cfg$map_dpi %||% 300,
      show_legend = FALSE
    )
    
    rm(r_plot, sub, rcl_impact); gc()
  }
  
  message("RIRC module complete.")
}


