if (isTRUE(cfg$run_export)) {
  
  message("Exporting high-quality maps...")
  
  # ---------------------------------------------------------------------------
  # 6.0 Helpers
  # ---------------------------------------------------------------------------
  `%||%` <- function(a, b) if (!is.null(a)) a else b
  
  safe_name <- function(x) {
    x <- as.character(x %||% "NA")
    x <- gsub("[^[:alnum:]_\\-]+", "_", x)
    x <- gsub("_+", "_", x)
    x <- gsub("^_|_$", "", x)
    x
  }
  
  dir.create(maps_dir, showWarnings = FALSE, recursive = TRUE)
  dir.create(tables_dir, showWarnings = FALSE, recursive = TRUE)
  
  species_tag <- safe_name(cfg$species_name)
  area_tag    <- safe_name(cfg$study_area_name)
  stamp_tag   <- format(Sys.time(), "%Y%m%d_%H%M%S")
  file_tag    <- paste(species_tag, area_tag, stamp_tag, sep = "_")
  
  # ---------------------------------------------------------------------------
  # 6.1 Select raster
  # ---------------------------------------------------------------------------
  if (exists("local_pred")) {
    habitat_map_rast <- local_pred
  } else if (exists("regional_suit_presence")) {
    habitat_map_rast <- regional_suit_presence
  } else {
    stop("No prediction raster available for map export.")
  }
  
  if (!inherits(habitat_map_rast, "SpatRaster")) {
    stop("Selected habitat map is not a terra SpatRaster.")
  }
  
  # enforce single-layer raster
  if (terra::nlyr(habitat_map_rast) > 1) {
    message("Prediction raster has multiple layers; using the first layer only.")
    habitat_map_rast <- habitat_map_rast[[1]]
  }
  
  if (is.null(names(habitat_map_rast)) || names(habitat_map_rast) == "") {
    names(habitat_map_rast) <- "Suitability"
  } else {
    names(habitat_map_rast) <- "Suitability"
  }
  
  # ---------------------------------------------------------------------------
  # 6.2 Select boundary
  # ---------------------------------------------------------------------------
  if (exists("study_bnd")) {
    study_bnd_plot <- study_bnd
  } else if (!is.null(cfg$boundary_file) && file.exists(cfg$boundary_file)) {
    study_bnd_plot <- sf::st_read(cfg$boundary_file, quiet = TRUE)
  } else {
    stop("Boundary file not available for map export.")
  }
  
  study_bnd_plot <- sf::st_make_valid(study_bnd_plot)
  
  # ---------------------------------------------------------------------------
  # 6.3 CRS harmonization and masking
  # ---------------------------------------------------------------------------
  r_crs <- terra::crs(habitat_map_rast, proj = TRUE)
  if (is.na(r_crs) || !nzchar(r_crs)) {
    stop("Prediction raster has missing CRS.")
  }
  
  study_bnd_plot <- sf::st_transform(study_bnd_plot, crs = r_crs)
  study_vect_plot <- terra::vect(study_bnd_plot)
  
  habitat_map_rast <- terra::crop(habitat_map_rast, study_vect_plot)
  habitat_map_rast <- terra::mask(habitat_map_rast, study_vect_plot)
  
  # ---------------------------------------------------------------------------
  # 6.4 Inspect raster values
  # ---------------------------------------------------------------------------
  vals <- terra::values(habitat_map_rast, mat = FALSE)
  vals_non_na <- vals[!is.na(vals)]
  
  if (length(vals_non_na) == 0) {
    stop("Prediction raster contains no non-NA values after cropping/masking.")
  }
  
  message("Raster summary for export:")
  message("  n non-NA cells: ", length(vals_non_na))
  message("  min: ", signif(min(vals_non_na), 5))
  message("  max: ", signif(max(vals_non_na), 5))
  
  uniq_n <- length(unique(round(vals_non_na, 6)))
  message("  approx. unique values: ", uniq_n)
  
  if (uniq_n <= 2) {
    warning("Raster has very few unique values; map may appear nearly uniform.")
  }
  
  # ---------------------------------------------------------------------------
  # 6.5 Build plotting dataframe explicitly
  # ---------------------------------------------------------------------------
  rr <- terra::as.data.frame(habitat_map_rast, xy = TRUE, na.rm = FALSE)
  val_col <- setdiff(names(rr), c("x", "y"))[1]
  names(rr)[names(rr) == val_col] <- "suitability"
  rr$suitability <- as.numeric(rr$suitability)
  
  # optional clipping of weird values
  rr <- rr %>%
    dplyr::filter(!is.na(x), !is.na(y))
  
  # ---------------------------------------------------------------------------
  # 6.6 Build map explicitly with numeric fill
  # ---------------------------------------------------------------------------
  habitat_map <- ggplot2::ggplot() +
    ggplot2::geom_raster(
      data = rr,
      ggplot2::aes(x = x, y = y, fill = suitability)
    ) +
    ggplot2::geom_sf(
      data = study_bnd_plot,
      fill = NA,
      color = "black",
      linewidth = 0.4
    ) +
    ggplot2::scale_fill_viridis_c(
      option = "C",
      name = "Suitability",
      na.value = "transparent"
    ) +
    ggplot2::coord_sf(datum = NA) +
    ggplot2::labs(
      title = paste0(cfg$species_name, " habitat suitability in ", cfg$study_area_name),
      subtitle = "High-quality SDM map export",
      caption = "Generated by the generalized SDM pipeline"
    ) +
    ggplot2::theme_minimal(base_size = 11) +
    ggplot2::theme(
      legend.position = "right",
      plot.title = ggplot2::element_text(face = "bold"),
      axis.title = ggplot2::element_blank(),
      panel.grid = ggplot2::element_blank()
    )
  
  # ---------------------------------------------------------------------------
  # 6.7 Output paths
  # ---------------------------------------------------------------------------
  png_map_file <- file.path(maps_dir, paste0(file_tag, "_habitat_suitability.png"))
  tif_map_file <- file.path(maps_dir, paste0(file_tag, "_habitat_suitability.tif"))
  pdf_map_file <- file.path(maps_dir, paste0(file_tag, "_habitat_suitability.pdf"))
  map_rds_file <- file.path(maps_dir, paste0(file_tag, "_habitat_suitability_plot.rds"))
  
  # ---------------------------------------------------------------------------
  # 6.8 Save PNG
  # ---------------------------------------------------------------------------
  if (requireNamespace("ragg", quietly = TRUE)) {
    ggplot2::ggsave(
      filename = png_map_file,
      plot = habitat_map,
      device = ragg::agg_png,
      width = cfg$map_width %||% 10,
      height = cfg$map_height %||% 8,
      units = "in",
      dpi = cfg$map_dpi %||% 600,
      background = "white"
    )
  } else {
    ggplot2::ggsave(
      filename = png_map_file,
      plot = habitat_map,
      device = "png",
      width = cfg$map_width %||% 10,
      height = cfg$map_height %||% 8,
      units = "in",
      dpi = cfg$map_dpi %||% 600,
      bg = "white"
    )
  }
  
  # ---------------------------------------------------------------------------
  # 6.9 Save TIFF
  # ---------------------------------------------------------------------------
  ggplot2::ggsave(
    filename = tif_map_file,
    plot = habitat_map,
    device = "tiff",
    width = cfg$map_width %||% 10,
    height = cfg$map_height %||% 8,
    units = "in",
    dpi = cfg$map_dpi %||% 600,
    compression = "lzw",
    bg = "white"
  )
  
  # ---------------------------------------------------------------------------
  # 6.10 Save PDF
  # ---------------------------------------------------------------------------
  if (capabilities("cairo")) {
    ggplot2::ggsave(
      filename = pdf_map_file,
      plot = habitat_map,
      device = grDevices::cairo_pdf,
      width = cfg$map_width %||% 10,
      height = cfg$map_height %||% 8,
      units = "in",
      bg = "white"
    )
  } else {
    ggplot2::ggsave(
      filename = pdf_map_file,
      plot = habitat_map,
      device = grDevices::pdf,
      width = cfg$map_width %||% 10,
      height = cfg$map_height %||% 8,
      units = "in",
      bg = "white",
      useDingbats = FALSE
    )
  }
  
  saveRDS(habitat_map, file = map_rds_file)
  
  message("High-quality maps saved successfully:")
  message("PNG: ", normalizePath(png_map_file, winslash = "/", mustWork = FALSE))
  message("TIFF: ", normalizePath(tif_map_file, winslash = "/", mustWork = FALSE))
  message("PDF: ", normalizePath(pdf_map_file, winslash = "/", mustWork = FALSE))
  message("RDS: ", normalizePath(map_rds_file, winslash = "/", mustWork = FALSE))
}

