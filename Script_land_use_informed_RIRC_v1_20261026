detect_lon_lat <- function(nms) {
  nms_low <- tolower(nms)
  lon_candidates <- which(nms_low %in% c("longitude", "lon", "long", "x", "decimal_longitude"))
  lat_candidates <- which(nms_low %in% c("latitude", "lat", "y", "decimal_latitude"))
  list(lon = lon_candidates[1], lat = lat_candidates[1])
}

extract_year <- function(x) {
  y <- suppressWarnings(as.integer(substr(as.character(x), 1, 4)))
  y[!is.finite(y)] <- NA_integer_
  y
}

extract_uncertainty_m <- function(x) {
  u <- suppressWarnings(as.numeric(gsub("[^0-9.]", "", as.character(x))))
  u[!is.finite(u)] <- NA_real_
  u
}

standardize_bio_names <- function(x) {
  x <- tolower(x)
  x <- gsub("[^a-z0-9]+", "", x)
  x <- gsub("^bio0*", "bio", x)
  x
}

calc_binary_metrics <- function(obs, prob, thr) {
  keep <-complete.cases(obs, prob)
  obs <- obs[keep]
  prob <- prob[keep]
  
  pred <- ifelse(prob >= thr, 1, 0)
  
  tp <- sum(obs == 1 & pred == 1)
  tn <- sum(obs == 0 & pred == 0)
  fp <- sum(obs == 0 & pred == 1)
  fn <- sum(obs == 1 & pred == 0)
  
  sens <- ifelse((tp + fn) > 0, tp / (tp + fn), NA_real_)
  spec <- ifelse((tn + fp) > 0, tn / (tn + fp), NA_real_)
  tss  <- sens + spec - 1
  acc  <- ifelse(sum(!is.na(obs)) > 0, mean(pred == obs, na.rm = TRUE), NA_real_) #for binary 0/1 data, this is mathematically equivalent to: (tp + tn) / (tp + tn + fp + fn)
  
  data.frame(
    threshold = thr,
    sensitivity = sens,
    specificity = spec,
    TSS = tss,
    accuracy = acc
  )
}

calc_auc <- function(obs, prob) {
  if (length(unique(obs)) < 2) return(NA_real_)
  as.numeric(pROC::auc(pROC::roc(obs, prob, quiet = TRUE)))
}

calc_optimal_threshold <- function(truth, prob, method = c("youden", "closest_topleft")) {
  method <- match.arg(method)
  
  # --- internal safe numeric coercion ---
  to_num <- function(x) {
    if (is.data.frame(x)) {
      if (ncol(x) != 1) stop("Input data.frame must have exactly 1 column.")
      x <- x[[1]]
    }
    if (is.list(x)) x <- unlist(x, recursive = TRUE, use.names = FALSE)
    if (is.factor(x)) x <- as.character(x)
    if (is.logical(x)) x <- as.integer(x)
    suppressWarnings(as.numeric(x))
  }
  
  y <- to_num(truth)
  p <- to_num(prob)
  
  ok <- is.finite(y) & is.finite(p)
  y <- y[ok]; p <- p[ok]
  
  if (length(y) == 0) stop("calc_optimal_threshold: no valid rows.")
  if (!all(y %in% c(0, 1))) stop("calc_optimal_threshold: truth must be binary 0/1.")
  
  n_pos <- sum(y == 1); n_neg <- sum(y == 0)
  if (n_pos == 0 || n_neg == 0) {
    warning("Only one class present.")
    return(NA_real_)
  }
  
  thr <- sort(unique(p))
  if (length(thr) == 1) return(as.numeric(thr))
  
  sens <- numeric(length(thr))
  spec <- numeric(length(thr))
  
  for (i in seq_along(thr)) {
    t <- thr[i]
    pred_pos <- p >= t
    
    tp <- sum(pred_pos & y == 1)
    fn <- sum(!pred_pos & y == 1)
    tn <- sum(!pred_pos & y == 0)
    fp <- sum(pred_pos & y == 0)
    
    sens[i] <- tp / (tp + fn)
    spec[i] <- tn / (tn + fp)
  }
  
  if (method == "youden") {
    score <- sens + spec - 1
    best <- which.max(score)
    best_idx <- which(score == score[best])
  } else {
    fpr <- 1 - spec
    d <- sqrt((fpr - 0)^2 + (sens - 1)^2)
    best <- which.min(d)
    best_idx <- which(d == d[best])
  }
  
  as.numeric(stats::median(thr[best_idx]))
}


get_ranger_prob <- function(model, newdata) {
  p <- predict(model, data = newdata)$predictions
  if (is.matrix(p)) {
    if ("1" %in% colnames(p)) return(as.numeric(p[, "1"]))
    return(as.numeric(p[, ncol(p)]))
  }
  as.numeric(p)
}

calc_vif <- function(df, threshold = 10) {
  if (ncol(df) < 2) return(list(data = df, excluded = character(0), vif = NULL))
  vif_res <- tryCatch(usdm::vif(df), error = function(e) NULL)
  if (is.null(vif_res)) return(list(data = df, excluded = character(0), vif = NULL))
  vif_df <- vif_res@results
  excluded <- character(0)
  while (nrow(vif_df) > 0 && max(vif_df$VIF, na.rm = TRUE) > threshold && ncol(df) > 2) {
    drop_var <- vif_df$Variables[which.max(vif_df$VIF)]
    excluded <- c(excluded, drop_var)
    df <- df[, setdiff(names(df), drop_var), drop = FALSE]
    vif_res <- tryCatch(usdm::vif(df), error = function(e) NULL)
    if (is.null(vif_res)) break
    vif_df <- vif_res@results
  }
  list(data = df, excluded = unique(excluded), vif = vif_df)
}

make_bias_surface <- function(pts, template_rast, smooth_m = 200000, agg_factor = 2L) {
  cells <- terra::extract(template_rast, pts, cells = TRUE)
  pres_cells <- unique(cells[, 2])
  bias <- terra::rast(template_rast)
  terra::values(bias) <- 0
  bias[pres_cells] <- 1
  bias <- terra::focal(
    bias,
    w = matrix(1, 5, 5),
    fun = mean,
    na.policy = "omit",
    fillvalue = 0
  )
  bias <- terra::aggregate(bias, fact = agg_factor, fun = mean, na.rm = TRUE)
  bias <- terra::disagg(bias, fact = agg_factor, method = "bilinear")
  bias <- terra::resample(bias, template_rast, method = "bilinear")
  bias <- terra::focal(
    bias,
    w = matrix(1, 7, 7),
    fun = mean,
    na.policy = "omit",
    fillvalue = 0
  )
  bias <- bias / max(terra::values(bias), na.rm = TRUE)
  bias[is.na(bias)] <- 0
  bias
}

ensure_same_geometry <- function(r1, r2) {
  if (!terra::compareGeom(r1, r2, stopOnError = FALSE)) {
    stop("Rasters do not share the same geometry/alignment.")
  }
  TRUE
}

prepare_for_excel <- function(x) {
  if (inherits(x, "sf")) x <- sf::st_drop_geometry(x)
  if (inherits(x, "SpatVector")) x <- as.data.frame(x, geom = FALSE)
  if (is.matrix(x) || inherits(x, "table")) x <- as.data.frame(x)
  if (is.atomic(x) && is.null(dim(x))) x <- data.frame(value = x)
  
  if (!is.data.frame(x)) {
    x <- tryCatch(as.data.frame(x), error = function(e) {
      stop("Could not convert object to data.frame: ", conditionMessage(e))
    })
  }
  
  list_columns <- vapply(x, is.list, logical(1))
  if (any(list_columns)) {
    x[list_columns] <- lapply(x[list_columns], function(column) {
      vapply(column, function(element) {
        if (is.null(element) || length(element) == 0L) return(NA_character_)
        paste(as.character(element), collapse = "; ")
      }, character(1))
    })
  }
  
  posixlt_columns <- vapply(x, inherits, logical(1), what = "POSIXlt")
  if (any(posixlt_columns)) {
    x[posixlt_columns] <- lapply(x[posixlt_columns], as.POSIXct)
  }
  
  excel_max_rows <- 1048576L
  if (nrow(x) + 1L > excel_max_rows) {
    stop("A table exceeds the Excel row limit.")
  }
  
  x
}

add_existing_object <- function(result_list, object_name, sheet_name = object_name) {
  if (exists(object_name, inherits = TRUE)) {
    object_value <- get(object_name, inherits = TRUE)
    if (!is.null(object_value)) {
      result_list[[sheet_name]] <- prepare_for_excel(object_value)
    }
  }
  result_list
}

safe_value <- function(object_name, default = NA) {
  if (!exists(object_name, inherits = TRUE)) return(default)
  value <- get(object_name, inherits = TRUE)
  if (is.null(value) || length(value) == 0L) return(default)
  value[1]
}

safe_table_value <- function(object_name, column_name, default = NA_real_) {
  if (!exists(object_name, inherits = TRUE)) return(default)
  object_value <- get(object_name, inherits = TRUE)
  if (
    is.null(object_value) ||
    !is.data.frame(object_value) ||
    nrow(object_value) == 0L ||
    !column_name %in% names(object_value)
  ) {
    return(default)
  }
  object_value[[column_name]][1]
}

sanitize_name <- function(x) {
  x <- tolower(x)
  x <- gsub("[^a-z0-9]+", "_", x)
  x <- gsub("^_|_$", "", x)
  x
}

pretty_title <- function(x) {
  x <- gsub("[_.]+", " ", x)
  tools::toTitleCase(x)
}

