if (isTRUE(cfg$run_export)) {
  
  message("Exporting results to Excel workbook...")
  
  if (!requireNamespace("openxlsx", quietly = TRUE)) {
    stop("Package 'openxlsx' is required for Excel export.")
  }
  
  `%||%` <- function(a, b) if (!is.null(a)) a else b
  
  # ---------- robust helpers ----------
  safe_metric <- function(df_name, col_name) {
    if (!exists(df_name, inherits = TRUE)) return(NA_real_)
    x <- get(df_name, inherits = TRUE)
    if (!is.data.frame(x) || !(col_name %in% names(x)) || nrow(x) == 0) return(NA_real_)
    suppressWarnings(as.numeric(x[[col_name]][1]))
  }
  
  prepare_for_excel_safe <- function(x) {
    # fallback if your prepare_for_excel is absent or fails
    if (!is.data.frame(x)) x <- as.data.frame(x, stringsAsFactors = FALSE)
    if (ncol(x) == 0) x <- data.frame(note = "empty_table", stringsAsFactors = FALSE)
    
    # flatten list-cols safely
    for (j in seq_len(ncol(x))) {
      if (is.list(x[[j]])) {
        x[[j]] <- vapply(
          x[[j]],
          function(z) paste(capture.output(str(z, give.attr = FALSE)), collapse = " "),
          character(1)
        )
      }
    }
    x
  }
  
  add_df_if_valid <- function(lst, obj_name, sheet_name) {
    if (!exists(obj_name, inherits = TRUE)) return(lst)
    obj <- get(obj_name, inherits = TRUE)
    if (!is.data.frame(obj)) return(lst)
    if (nrow(obj) == 0 && ncol(obj) == 0) return(lst)
    lst[[sheet_name]] <- obj
    lst
  }
  
  get_obj <- function(name, default = NULL) {
    if (exists(name, inherits = TRUE)) {
      get(name, inherits = TRUE)
    } else {
      default
    }
  }
  
  build_summary_sheet <- function(prefix) {
    
    cv_summary <- get_obj(paste0(prefix, "_cv_summary_all"))
    
    cv_auc_mean <- if (!is.null(cv_summary) &&
                       "AUC_mean" %in% names(cv_summary))
      mean(cv_summary$AUC_mean, na.rm = TRUE) else NA_real_
    
    cv_auc_sd <- if (!is.null(cv_summary) &&
                     "AUC_mean" %in% names(cv_summary))
      stats::sd(cv_summary$AUC_mean, na.rm = TRUE) else NA_real_
    
    cv_tss_mean <- if (!is.null(cv_summary) &&
                       "TSS_mean" %in% names(cv_summary))
      mean(cv_summary$TSS_mean, na.rm = TRUE) else NA_real_
    
    cv_tss_sd <- if (!is.null(cv_summary) &&
                     "TSS_mean" %in% names(cv_summary))
      stats::sd(cv_summary$TSS_mean, na.rm = TRUE) else NA_real_
    
    training_metrics_name <- paste0(prefix, "_training_metrics")
    
    if (exists("safe_table_value")) {
      
      training_sensitivity <- safe_table_value(training_metrics_name, "sensitivity")
      training_specificity <- safe_table_value(training_metrics_name, "specificity")
      training_tss         <- safe_table_value(training_metrics_name, "TSS")
      training_auc         <- safe_table_value(training_metrics_name, "AUC")
      
    } else {
      
      training_sensitivity <- safe_metric(training_metrics_name, "sensitivity")
      training_specificity <- safe_metric(training_metrics_name, "specificity")
      training_tss         <- safe_metric(training_metrics_name, "TSS")
      training_auc         <- safe_metric(training_metrics_name, "AUC")
    }
    
    final_threshold <- get_obj(
      paste0(prefix, "_optimal_threshold"),
      NA_real_
    )
    
    data.frame(
      Section = c(
        rep("Occurrence data", 6),
        rep("Model configuration", 2),
        rep("Spatial cross-validation", 4),
        rep("Apparent training performance", 4),
        rep("Final classification", 2)
      ),
      
      Metric = c(
        "Raw occurrences",
        "Occurrences after cleaning",
        "Occurrences after thinning",
        "Final presence records used",
        "Background points used",
        "Total records used",
        "Species name",
        "Study area name",
        "Mean AUC across CV blocks",
        "SD of AUC across CV blocks",
